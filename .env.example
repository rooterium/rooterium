# Copy to .env and adjust. Never commit .env (ADR 0007).

# --- Django ---------------------------------------------------------------

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# true only for local development
DEBUG=true

# Comma-separated host names, e.g. example.ch
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins incl. scheme; needed in production behind HTTPS,
# e.g. https://example.ch
CSRF_TRUSTED_ORIGINS=

# --- Production server (compose.prod.yaml, Caddy) ------------------------

# Domain Caddy serves and gets the TLS certificate for, e.g. example.ch.
# ":80" serves plain HTTP on the IP (testing before DNS points here).
SITE_ADDRESS=
# Comma-separated host names that redirect to SITE_ADDRESS, e.g.
# "www.example.ch". Only list names whose DNS already points to this server.
# Leave empty for no redirects.
REDIRECT_ADDRESSES=
# X-Robots-Tag header. Default "noindex, nofollow" for the test phase;
# set to "all" when the site goes live.
ROBOTS_TAG=noindex, nofollow
# Image tag to run; default latest. Pin sha-<commit> for a rollback.
IMAGE_TAG=latest
# APP_COMMIT (shown at /version) is baked into the image by CI – do not set.

# --- Database (PostgreSQL) ------------------------------------------------

# Used by the db container on first start.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Used by Django. Host "db" is the Compose service; use localhost when
# running Django outside Docker against a published port.
DATABASE_URL=postgres://app:change-me@db:5432/app

# --- Email (SMTP) ---------------------------------------------------------

# Leave EMAIL_BACKEND unset locally: emails are then printed to the console.
# Production:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=<SMTP server of the mail provider>
#   EMAIL_PORT=587          # Hostpoint: 587 with STARTTLS (465 not allowed)
#   EMAIL_USE_TLS=true      # STARTTLS on 587; for SSL on 465 instead:
#   EMAIL_USE_SSL=false     #   EMAIL_PORT=465, EMAIL_USE_SSL=true, EMAIL_USE_TLS=false
#   EMAIL_HOST_USER=<mailbox address>
#   EMAIL_HOST_PASSWORD='<mailbox password>'   # single quotes, see deployment.md
#   DEFAULT_FROM_EMAIL=<sender address – the same as EMAIL_HOST_USER>
DEFAULT_FROM_EMAIL=webmaster@localhost

# The editor's address for notifications about suggested events and
# projects ("Suggest an event / a project"). Empty: no email is sent; the
# drafts still appear in the Wagtail admin.
EDITOR_NOTIFICATION_EMAIL=
